{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socioprophet.org/prophet-core-ledger/wallguard-ledger-event.schema.json",
  "title": "WallGuard Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "event_id",
    "event_type",
    "wall_decision_id",
    "wall_decision_outcome",
    "reason_code",
    "policy_ref",
    "policy_version",
    "subject_ref",
    "action",
    "resource_refs",
    "resource_label_summary",
    "context_ref",
    "destination_ref",
    "enforcement_point",
    "receipt_visibility_class",
    "contains_restricted_payload",
    "evidence_refs",
    "recorded_at",
    "source_service"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "record_type": {"const": "WallGuardLedgerEvent"},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["wall_decision", "wall_access", "wall_collaboration", "wall_memory", "wall_retrieval", "wall_clean_room_release", "wall_override"]},
    "wall_decision_id": {"type": "string", "minLength": 1},
    "wall_decision_outcome": {"enum": ["allow", "deny", "redact", "quarantine", "escalate", "clean_room_release_requested", "clean_room_release_allowed", "clean_room_release_denied"]},
    "reason_code": {"type": "string", "minLength": 1},
    "policy_ref": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "resource_label_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_ref", "matter_ref", "wall_ref", "classification"],
      "properties": {
        "client_ref": {"type": "string", "minLength": 1},
        "matter_ref": {"type": "string", "minLength": 1},
        "wall_ref": {"type": "string", "minLength": 1},
        "classification": {"enum": ["public", "firm_approved", "client_confidential", "matter_restricted", "wall_restricted", "clean_room_derived"]}
      }
    },
    "context_ref": {"type": "string", "minLength": 1},
    "destination_ref": {"type": "string", "minLength": 1},
    "enforcement_point": {"type": "string", "minLength": 1},
    "receipt_visibility_class": {"enum": ["public", "public_sanitized", "internal", "sealed", "withheld_specific"]},
    "contains_restricted_payload": {"type": "boolean"},
    "redaction_summary": {"type": "string"},
    "residual_restrictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recorded_at": {"type": "string", "minLength": 1},
    "source_service": {"type": "string", "minLength": 1}
  }
}
